# INACTIVE DESIGN: review, approve and move to .github/workflows only afterwards.
# Configure Pages source=Actions, branch protection, protected github-pages environment
# and independent signing-key fingerprints first. No private key is used in this job.
name: Publish reviewed signed XBPS site
on:
  workflow_dispatch:
    inputs:
      bundle_url:
        description: Public HTTPS URL of reviewed full testing+stable site tar.gz
        required: true
        type: string
      bundle_sha256:
        description: Owner-reviewed SHA256 of that exact signed site bundle
        required: true
        type: string
permissions:
  contents: read
concurrency:
  group: pages
  cancel-in-progress: false
jobs:
  verify:
    if: github.ref == 'refs/heads/main' && vars.ENABLE_SIGNED_PUBLICATION == 'true'
    environment: publication-review
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          persist-credentials: false
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065
        with:
          python-version: '3.14'
      - name: Verify native signatures, signed manifest, hashes and channel approvals
        env:
          BUNDLE_URL: ${{ inputs.bundle_url }}
          BUNDLE_SHA256: ${{ inputs.bundle_sha256 }}
        run: python3 scripts/fetch-site.py "$BUNDLE_URL" "$BUNDLE_SHA256" site
      - uses: actions/upload-pages-artifact@56afc609e74202658d3ffba0e8f6dda462b719fa
        with:
          path: site
  deploy:
    needs: verify
    environment: github-pages
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      pages: write
      id-token: write
    steps:
      - uses: actions/deploy-pages@d6db90164ac5ed86f2b6aed7e0febac5b3c0c03e
